# Browserbase configuration
BROWSERBASE_API_KEY=your_browserbase_api_key

# Research configuration
RESEARCH_MODEL=google/gemini-2.5-flash
RESEARCH_ITERATIONS=2
NUM_QUERIES=4
RESULTS_PER_QUERY=5
MAX_FETCHES=10
MAX_BROWSER_FALLBACKS=2
MAX_SOURCES=8
MAX_SOURCES_PER_DOMAIN=2
CLAIMS_PER_SOURCE=5
MIN_QUALITY_SCORE=75
MIN_DISTINCT_DOMAINS=3
USE_RESEARCH_PLANNER=true
USE_STRATEGY_PLANNER=true
USE_BROWSER_SYNTHESIS=true
USE_VERIFIER=true
STOP_EARLY_ON_QUALITY=false
VERIFICATION_PASS_SCORE=80
USE_PROXIES=false
OUT_DIR=output
RESEARCH_WORKSPACE=research-workspace

# Optional FARA/WebTailBench-style benchmark mode
BENCH_TASKS_FILE=
BENCH_TASK_FORMAT=auto
BENCH_TASK_LIMIT=25
BENCH_OUTPUT_DIR=bench-output
BENCH_SUCCESS_CRITERION=outcome
